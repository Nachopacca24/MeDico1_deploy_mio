<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTPS to Railway backend -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">medico1deploymio-production.up.railway.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Allow HTTPS to production domain -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">medicoapp.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Default: HTTPS only, no cleartext -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
