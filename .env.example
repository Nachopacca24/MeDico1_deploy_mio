# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ===========================================
DB_NAME=medico
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Alternativa para Render/Railway (sobreescribe las variables anteriores)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ===========================================
# CONFIGURACIÓN DE DJANGO
# ===========================================
# Genera una nueva secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# REQUERIDO EN PRODUCCIÓN
DJANGO_SECRET_KEY=

# Ambiente
DJANGO_SETTINGS_MODULE=core.settings.dev

# Debug: True solo para desarrollo local, NUNCA en producción
DEBUG=True

# Hosts permitidos (separados por coma)
# Producción: dominio de Render + dominio propio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: DJANGO_ALLOWED_HOSTS=medico1-h5lk.onrender.com,tu-dominio.com

# CORS: orígenes permitidos del frontend (separados por coma)
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Producción: DJANGO_CORS_ORIGINS=https://me-dico1.vercel.app,https://tu-dominio.com

# CSRF: orígenes de confianza (separados por coma)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Producción: DJANGO_CSRF_TRUSTED_ORIGINS=https://me-dico1.vercel.app

# ===========================================
# CLOUDINARY - Almacenamiento de imágenes
# REQUERIDO EN PRODUCCIÓN
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# GOOGLE OAUTH / CALENDAR
# REQUERIDO si usas login con Google
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominio base para el redirect URI de Google (ej: medico1-h5lk.onrender.com)
REPLIT_DEV_DOMAIN=localhost:8000

# ===========================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# REQUERIDO EN PRODUCCIÓN para verificación de email
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MéDico <noreply@medico.com>

# URL del frontend (para links de verificación en emails)
FRONTEND_URL=http://localhost:5173
# Producción: FRONTEND_URL=https://me-dico1.vercel.app

# ===========================================
# SENTRY - Monitoreo de errores (Opcional)
# ===========================================
SENTRY_DSN=

# ===========================================
# CONFIGURACIÓN DE FRONTEND (Vite)
# ===========================================
VITE_API_URL=http://localhost:8000
# Producción: VITE_API_URL=https://medico1-h5lk.onrender.com

VITE_APP_NAME=MeDico1
VITE_APP_URL=http://localhost:5173

VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
